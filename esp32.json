{
    "network": {
        "import": "hw.esp32.wlan",
        "type": "WLAN"
    }, 
    "ble" : {
          "import": "hw.esp32.ble",
          "type": "BLEUART"
    },
    "uplink": {
        "import": "hw.esp32.uart",
